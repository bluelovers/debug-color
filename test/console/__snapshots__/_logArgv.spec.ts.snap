exports[`Console Internal - _logArgv _logArgv documented snapshots should document various configurations 1`] = `
[
  {
    "#id": "logArgv-001",
    "explain": "✅ 基本日誌 / Basic log",
    "input": {
      "argv": [
        "hello",
      ],
      "name": "log",
    },
    "result": {
      "arr": [
        "[0mhello[0m",
      ],
      "arrCount": 1,
      "name": "log",
    },
    "tags": "basic, log",
  },
  {
    "#id": "logArgv-002",
    "explain": "✅ 錯誤日誌 / Error log",
    "input": {
      "argv": [
        "error occurred",
      ],
      "name": "error",
    },
    "result": {
      "arr": [
        "[0m[31merror occurred[39m[0m",
      ],
      "arrCount": 1,
      "name": "error",
    },
    "tags": "error",
  },
  {
    "#id": "logArgv-003",
    "explain": "✅ 啟用時間 / Time enabled",
    "input": {
      "argv": [
        "test",
      ],
      "name": "log",
    },
    "result": {
      "arr": [
        "[0m[11:03:02.317][0m",
        "[0mtest[0m",
      ],
      "arrCount": 2,
      "name": "log",
    },
    "tags": "time, timestamp",
  },
  {
    "#id": "logArgv-004",
    "explain": "✅ 啟用標籤 / Label enabled",
    "input": {
      "argv": [
        "test",
      ],
      "name": "log",
    },
    "result": {
      "arr": [
        "[0m[LOG][0m",
        "[0mtest[0m",
      ],
      "arrCount": 2,
      "name": "log",
    },
    "tags": "label, tag",
  },
  {
    "#id": "logArgv-005",
    "explain": "✅ 自訂顏色 / Custom colors",
    "input": {
      "argv": [
        "test",
      ],
      "name": "log",
    },
    "result": {
      "arr": [
        "[0m[32mtest[39m[0m",
      ],
      "arrCount": 1,
      "name": "log",
    },
    "tags": "colors, custom",
  },
  {
    "#id": "logArgv-006",
    "explain": "✅ 多個參數 / Multiple arguments",
    "input": {
      "argv": [
        "a",
        "b",
        "c",
        123,
      ],
      "name": "log",
    },
    "result": {
      "arr": [
        "[0ma b c 123[0m",
      ],
      "arrCount": 1,
      "name": "log",
    },
    "tags": "multiple, args",
  },
]
`;

