exports[`Console Internal - _logErrorArgv _logErrorArgv documented snapshots should document error handling behavior 1`] = `
[
  {
    "#id": "errorArgv-001",
    "explain": "✅ 基本錯誤 / Basic error",
    "input": {
      "argv": [
        "error occurred",
      ],
      "failBack": "error",
      "name": "error",
    },
    "result": {
      "arr": [
        "[0m[31merror occurred[39m[0m",
      ],
      "name": "error",
    },
    "tags": "error, basic",
  },
  {
    "#id": "errorArgv-002",
    "explain": "✅ 警告回退 / Warn fallback",
    "input": {
      "argv": [
        "test",
      ],
      "failBack": "warn",
      "name": "fail",
    },
    "result": {
      "arr": [
        "[0m[31mtest[39m[0m",
      ],
      "name": "warn",
    },
    "tags": "error, fallback",
  },
  {
    "#id": "errorArgv-003",
    "explain": "✅ 多個參數 / Multiple arguments",
    "input": {
      "argv": [
        "Error:",
        "code:",
        500,
      ],
      "failBack": "error",
      "name": "error",
    },
    "result": {
      "arr": [
        "[0m[31mError: code: 500[39m[0m",
      ],
      "name": "error",
    },
    "tags": "error, multiple",
  },
]
`;
