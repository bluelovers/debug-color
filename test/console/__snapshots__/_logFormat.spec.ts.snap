// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`Console Internal - _logFormat _logFormat documented snapshots should document complete behavior 1`] = `
[
  {
    "#id": "format-001",
    "explain": "✅ 空參數 / Empty arguments",
    "input": {
      "argv": [],
    },
    "result": "",
    "tags": "basic, empty",
  },
  {
    "#id": "format-002",
    "explain": "✅ 單一參數 / Single argument",
    "input": {
      "argv": [
        "message",
      ],
    },
    "result": "message",
    "tags": "basic, single",
  },
  {
    "#id": "format-003",
    "explain": "✅ 多個字串 / Multiple strings",
    "input": {
      "argv": [
        "a",
        "b",
        "c",
      ],
    },
    "result": "a b c",
    "tags": "basic, strings",
  },
  {
    "#id": "format-004",
    "explain": "✅ 混合類型 / Mixed types",
    "input": {
      "argv": [
        "count:",
        123,
        "status:",
        "active",
      ],
    },
    "result": "count: 123 status: active",
    "tags": "mixed, string-number",
  },
  {
    "#id": "format-005",
    "explain": "✅ 陣列參數 / Array argument",
    "input": {
      "argv": [
        [
          1,
          2,
          3,
        ],
      ],
    },
    "result": "[ 1, 2, 3 ]",
    "tags": "array",
  },
  {
    "#id": "format-006",
    "explain": "✅ 函式參數 / Function argument",
    "input": {
      "argv": [
        [Function],
      ],
    },
    "result": "[Function: testFn]",
    "tags": "function",
  },
]
`;

exports[`Console Internal - _logFormat _logFormat with format specifiers should match snapshot for format specifiers 1`] = `
[
  {
    "explain": "✅ %s 標記 / %s specifier",
    "input": {
      "argv": [
        "Hello %s",
        "World",
      ],
    },
    "result": "Hello World",
  },
  {
    "explain": "✅ %d 標記 / %d specifier",
    "input": {
      "argv": [
        "Count: %d",
        100,
      ],
    },
    "result": "Count: 100",
  },
  {
    "explain": "✅ %j 標記 / %j specifier",
    "input": {
      "argv": [
        "%j",
        {
          "key": "value",
        },
      ],
    },
    "result": "{"key":"value"}",
  },
  {
    "explain": "✅ 多個標記 / Multiple specifiers",
    "input": {
      "argv": [
        "%s: %d",
        "Answer",
        42,
      ],
    },
    "result": "Answer: 42",
  },
]
`;

