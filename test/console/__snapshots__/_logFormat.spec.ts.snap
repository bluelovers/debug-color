exports[`Console Internal - _logFormat _logFormat with object arguments should format mixed object and string 1`] = `"message: { foo: 'bar' }"`;

exports[`Console Internal - _logFormat _logFormat with object arguments should match snapshot for object arguments 1`] = `
[
  {
    "explain": "✅ 簡單物件 / Simple object",
    "input": {
      "argv": [
        {
          "name": "test",
        },
      ],
    },
    "result": "{ name: 'test' }",
  },
  {
    "explain": "✅ 巢狀物件 / Nested object",
    "input": {
      "argv": [
        {
          "user": {
            "age": 30,
            "name": "Alice",
          },
        },
      ],
    },
    "result": "{ user: { name: 'Alice', age: 30 } }",
  },
  {
    "explain": "✅ 混合參數 / Mixed arguments",
    "input": {
      "argv": [
        "User:",
        {
          "active": true,
          "name": "Bob",
        },
      ],
    },
    "result": "User: { name: 'Bob', active: true }",
  },
]
`;

